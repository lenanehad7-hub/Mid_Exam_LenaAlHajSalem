<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    tools:context=".ArtworkDetailsActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Artwork Details"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#EFEFEF"
        android:padding="20dp"
        android:layout_marginBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Title:"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#444444" />

        <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Title here"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Artist &amp; Creation Year:"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#444444" />

        <TextView
            android:id="@+id/tvDetailArtistYear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Artist and year here"
            android:textSize="18sp"
            android:textColor="#333333" />

    </LinearLayout>

    <Button
        android:id="@+id/btnVisitWebsite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Visit Website"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnBackToGallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Gallery" />

</LinearLayout>
